# Deployment Mode
# Set to 'cloud' for production with Clerk authentication
# Leave unset or 'local' for local development without auth
MANIFEST_MODE=local

# Server Configuration
MANIFEST_BIND_ADDR=127.0.0.1
MANIFEST_PORT=17010

# Clerk Authentication (required when MANIFEST_MODE=cloud)
# Get these from your Clerk dashboard: https://dashboard.clerk.com
# CLERK_DOMAIN=your-app.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=https://your-domain.fly.dev

# API Key Authentication (optional, for API key based auth)
# MANIFEST_API_KEY=your-api-key-here

# Rate Limiting (optional)
# MANIFEST_RATE_LIMIT_REQUESTS=100
# MANIFEST_RATE_LIMIT_WINDOW_SECS=60

# CORS Origins (optional, comma-separated)
# MANIFEST_CORS_ORIGINS=https://your-domain.fly.dev,http://localhost:5173

# Logging
RUST_LOG=manifest=debug,tower_http=debug
